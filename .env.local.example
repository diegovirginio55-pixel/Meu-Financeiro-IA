# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui

# Google Gemini (gratuito, sem cartão) — https://aistudio.google.com/apikey
GEMINI_API_KEY=sua-chave-gemini-aqui
# Perguntas por dia no chat (o plano grátis zera à meia-noite de Los Angeles)
# GEMINI_DAILY_QUESTION_LIMIT=20

# Pluggy (Open Finance) — https://dashboard.pluggy.ai
PLUGGY_CLIENT_ID=seu-client-id
PLUGGY_CLIENT_SECRET=seu-client-secret

# Supabase service role (Project Settings > API) — só no servidor
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# Opcional: chaves Web Push. Se vazio, o app gera e guarda no Supabase.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# Segredo do cron de sincronização (GET /api/bank/cron). Gere um valor
# aleatório e use o MESMO valor aqui, no Render (env var do serviço web) e
# no GitHub (Settings > Secrets and variables > Actions > BANK_CRON_SECRET)
# — é o que faz o app puxar os bancos e avisar por notificação sem esperar
# você abrir o app. Ver .github/workflows/bank-cron.yml.
BANK_CRON_SECRET=gere-um-valor-aleatorio-aqui
